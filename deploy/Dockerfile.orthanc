# Orthanc PACS for petsFollow — PostgreSQL index + GCS storage (image -full).
# Build: docker build -f deploy/Dockerfile.orthanc -t petsfollow-orthanc .
# Local compose uses orthancteam/orthanc:24.12.0 (non-full) + orthanc.local.json.
#
# IMPORTANT: keep Orthanc Team ENTRYPOINT (/docker-entrypoint.sh). It symlinks
# plugins from plugins-available → plugins/ before starting Orthanc. A custom
# ENTRYPOINT that exec's Orthanc directly leaves an empty plugins dir and falls
# back to SQLite + /tmp filesystem (data lost on every Cloud Run cold start).
FROM orthancteam/orthanc:24.12.0-full

USER root
# Non-secret defaults merged by generateConfiguration.py with ORTHANC__* env.
# GoogleCloudStorage.ServiceAccountFile must match the Cloud Run secret mount
# (setup-orthanc.sh → /var/run/secrets/petsfollow-gcs-sa.json).
COPY infra/orthanc/orthanc.json /etc/orthanc/petsfollow.json

ENV VERBOSE_ENABLED=true \
    POSTGRESQL_PLUGIN_ENABLED=true \
    GOOGLE_CLOUD_STORAGE_PLUGIN_ENABLED=true \
    DICOM_WEB_PLUGIN_ENABLED=true

# Cloud Run --port=8080; HttpPort also set in petsfollow.json / ORTHANC__HTTP_PORT.
EXPOSE 8080
# ENTRYPOINT + CMD inherited from orthancteam/orthanc (docker-entrypoint.sh /etc/orthanc/)
