FROM node:22-alpine AS builder
WORKDIR /app
COPY nuxtjs/package*.json ./nuxtjs/
RUN cd nuxtjs && npm install
COPY nuxtjs ./nuxtjs
COPY brand ./brand
# CSP + public runtime : URL API (pas localhost). Override via --build-arg / compose.
ARG NUXT_PUBLIC_API_BASE=https://api.petsfollow.ll-it-sc.be
# Défaut production : staging uniquement via --build-arg (Cloud Build).
ARG NUXT_PUBLIC_APP_ENV=production
# Modules tag « dev » — off par défaut ; staging Cloud Build passe true.
ARG NUXT_PUBLIC_PHARMACY_ENABLED=false
ARG NUXT_PUBLIC_BILLIT_ENABLED=false
ARG NUXT_PUBLIC_PRESCRIPTIONS_ENABLED=false
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE
ENV NUXT_PUBLIC_APP_ENV=$NUXT_PUBLIC_APP_ENV
ENV NUXT_PUBLIC_PHARMACY_ENABLED=$NUXT_PUBLIC_PHARMACY_ENABLED
ENV NUXT_PUBLIC_BILLIT_ENABLED=$NUXT_PUBLIC_BILLIT_ENABLED
ENV NUXT_PUBLIC_PRESCRIPTIONS_ENABLED=$NUXT_PUBLIC_PRESCRIPTIONS_ENABLED
# Nitro SSR build dépasse le défaut ~2 Go sur Cloud Build (OOM mark-compact).
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN cd nuxtjs && npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/nuxtjs/.output ./.output
ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
