FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ .
# -trimpath : pas de chemins de build absolus dans le binaire.
# -s -w : table de symboles et DWARF retirés (~25 % de binaire en moins).
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /petsfollow-api ./cmd/petsfollow-api

FROM alpine:3.22
# tzdata: IANA zones for time.LoadLocation (client booking slots, emails).
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 petsfollow
WORKDIR /app
COPY --from=builder /petsfollow-api /app/petsfollow-api
USER petsfollow
EXPOSE 8080
ENTRYPOINT ["/app/petsfollow-api"]
