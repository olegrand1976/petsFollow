# petsFollow — environnement local
# local | dev | test | staging | production — seed et seed-mass refusent toute autre valeur (y compris vide).
APP_ENV=local
PETSFOLLOW_DB_PORT=5437
PETSFOLLOW_REDIS_PORT=6382
PETSFOLLOW_API_PORT=8291
PETSFOLLOW_NUXTJS_PORT=3002
PETSFOLLOW_MAILHOG_SMTP_PORT=1027
PETSFOLLOW_MAILHOG_UI_PORT=8027
PETSFOLLOW_ORTHANC_PORT=8042

DATABASE_URL=postgres://petsfollow:petsfollow@localhost:5437/petsfollow?sslmode=disable
REDIS_ADDR=localhost:6382
REDIS_KEY_PREFIX=petsfollow:
HTTP_ADDR=:8291
JWT_SIGNING_KEY=dev-change-me-in-production
# Prod/staging Cloud Run : Secret Manager `petsfollow-jwt-signing-key` (obligatoire,
# fail-fast au boot si absent/faible hors DEV_SEED_ENABLED). Jamais de secret aléatoire par instance.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
MIGRATE_ON_BOOT=true
DEV_SEED_ENABLED=true
# Pharmacie cabinet (CNK / stock / DAF) — off en prod tant que non GA ; on en local via make api-dev.
PHARMACY_ENABLED=true
NUXT_PUBLIC_PHARMACY_ENABLED=true
# VAMReg : dry-run sync à finalize antibiotique (défaut config). Asynq si PHARMACY_WORKERS_ENABLED=true + Redis.
VAMREG_DRY_RUN=true
# VAMREG_BASE_URL=
# VAMREG_API_KEY=
PHARMACY_WORKERS_ENABLED=false
# SMS transactionnel Telnyx (confirmation / rappel J-1 / reprogrammation RDV).
# Dry-run par défaut : les messages sont loggés, aucun appel Telnyx, aucun coût.
SMS_ENABLED=true
SMS_DRY_RUN=true
# Indicatif appliqué aux numéros nationaux (0470...) pour obtenir de l'E.164 : BE|FR|NL|LU.
SMS_DEFAULT_REGION=BE
# TELNYX_API_KEY=
# TELNYX_MESSAGING_PROFILE_ID=
# TELNYX_FROM=
# Clé publique du portail Telnyx (Auth) : valide la signature Ed25519 des webhooks
# DLR / SMS entrants. Sans elle, tout webhook est rejeté en 401.
# TELNYX_PUBLIC_KEY=
# Secret du cron rappel J-1 (header X-Visit-Reminders-Secret).
VISIT_REMINDERS_SECRET=dev-visit-reminders
# Prescriptions (brouillons + preview PDF) — off en prod tant que non GA ; on en local via make api-dev.
PRESCRIPTIONS_ENABLED=true
NUXT_PUBLIC_PRESCRIPTIONS_ENABLED=true
# PACS Orthanc local (make up-pacs) — make api-dev force URL/password si absents.
PACS_ENABLED=true
NUXT_PUBLIC_PACS_ENABLED=true
PACS_ORTHANC_URL=http://localhost:8042
PACS_ORTHANC_USER=petsfollow
PACS_ORTHANC_PASSWORD=petsfollow
PACS_ORTHANC_USE_ID_TOKEN=false
# Client AI Flutter (vulgarisation CR + triage 24/7) — tag dev ; make api-dev / flutter-dev force true.
CLIENT_AI_ENABLED=true
# Secret job quotidien auto-quarantaine + digest (local optionnel)
PHARMACY_EXPIRY_SECRET=dev-pharmacy-expiry
# Staging Cloud Run only: enables admin Pro « RESET STAGING » (never enable in prod).
# ADMIN_STAGING_SEED_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1027
# Local: MailHog (pas d'auth). Staging OVH : SMTP_USER=noreply@petsfollow.app + SMTP_PASS (secret).
SMTP_FROM="petsFollow <noreply@petsfollow.test>"
# SMTP_USER=
# SMTP_PASS=
# Destinataire des leads « nouveau véto » (app client) — vide = stockage seul, pas d'email
OPS_NOTIFY_EMAIL=
# Repli global optionnel (mail/PDF dossier public) si le commercial rattaché n'a pas de
# contact_phone. Vide en staging/prod est VOLONTAIRE : la source réelle est le profil
# (gate /complete-contact-phone + seed). Ne pas inventer un numéro au build.
COMMERCIAL_CONTACT_PHONE=
SUPPORT_INBOX_EMAIL=support@petsfollow.app
HEARTRATE_DURATION_SEC=60

NUXT_PUBLIC_API_BASE=http://localhost:8291
# local | staging | production — badge S (staging AUTH) + pages usecases (staging|local)
NUXT_PUBLIC_APP_ENV=local
# Client OAuth Web (public) — même valeur pour Nuxt Pro + API Go + Flutter --dart-define
NUXT_PUBLIC_GOOGLE_CLIENT_ID=237481297060-90gihf09ec8pv2cc3jhnnodjo00vejde.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=237481297060-90gihf09ec8pv2cc3jhnnodjo00vejde.apps.googleusercontent.com
PETSFOLLOW_PUBLIC_SITE_URL=http://localhost:3002
PETSFOLLOW_API_PUBLIC_URL=http://localhost:8291

# Stripe billing — mock uniquement sur opt-in explicite (jamais inféré d'une clé absente)
BILLING_MOCK_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_test
STRIPE_PRICE_ANNUAL_ONETIME=
STRIPE_PRICE_TRIENNIAL_ONETIME=
STRIPE_PRICE_QUINQUENNIAL_ONETIME=
STRIPE_PRICE_MONTHLY_SUB=
STRIPE_PRICE_ANNUAL_SUB=
STRIPE_PRICE_TRIENNIAL_SUB=
# STRIPE_PRICE_QUINQUENNIAL_SUB — legacy unused
# Addons (Family/Kennel/Care+/Horse) — no longer sold; env vars optional for legacy webhooks
STRIPE_SUCCESS_URL=petsfollow://payment/success
STRIPE_CANCEL_URL=petsfollow://payment/cancel

# Billit reseller (facturation Pro) — off en prod tant que non GA ; on en local via make api-dev / .env.
# UI Pro métier gelée séparément : INVOICING_UI_ENABLED dans nuxtjs/utils/invoicing-ui.ts (false = écran WIP).
BILLIT_ENABLED=true
NUXT_PUBLIC_BILLIT_ENABLED=true
# true = mock CI/local (make api-dev). Live sandbox : make api-billit-live + make billit-sandbox-smoke
BILLIT_MOCK_ENABLED=true
BILLIT_BASE_URL=https://api.billit.be
BILLIT_RESELLER_REGISTER_URL=https://my.billit.be/account/PetsFollow/Register
# BILLIT_WEBHOOK_SECRET=
BILLIT_DEFAULT_DOCS_INCLUDED=50
BILLIT_SECRETS_BACKEND=plain_dev
# BILLIT_SECRETS_KEY=
# BILLIT_MASTER_PARTY_ID=
# BILLIT_MASTER_API_KEY=
# Prix SaaS HT (centimes) — défaut 8800 = 88 €
# INVOICING_SAAS_PRICE_EUR_CENTS=8800
# Opt-in Flux A sans flag DB (UUIDs séparés par virgule)
# INVOICING_SAAS_ALLOWLIST=
# Cron brouillons Flux A C1 : POST /api/v1/internal/saas-invoices/run (boucle batches ; ?batch=1 pour un lot)
# SAAS_INVOICES_SECRET=
# Smoke live optionnel : BILLIT_SMOKE_PARTY_ID= BILLIT_SMOKE_API_KEY=
# Smoke Flux A master : BILLIT_MASTER_* + make billit-saas-master-smoke (+ BILLIT_SMOKE_SAAS_SEND=1)

GCP_PROJECT_ID=premedica-prod-2025
GCP_RUN_REGION=europe-west9
CUSTOM_DOMAIN=petsfollow.ll-it-sc.be
API_CUSTOM_DOMAIN=api.petsfollow.ll-it-sc.be

# Branding emails
LLIT_WEBSITE_URL=https://ll-it-sc.be

# Parcours e-mail client (engagement)
JOURNEY_EMAIL_ENABLED=true
JOURNEY_EMAIL_INTERVAL=1h
PETS_APP_DOWNLOAD_URL=

# Import clients admin — mapping colonnes (optionnel : mapping manuel sans clé)
# Aussi utilisé pour l'entraînement pitch (véto + coach + analyseur)
GEMINI_API_KEY=
# Pitch texte (/turn, stream, coach) — agentique
GEMINI_MODEL=gemini-3.6-flash
# Haut débit / bas coût (import mapping, analyzer batch)
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# Entraînement pitch temps réel (WebSocket audio natif) — modèle preview, changeable sans redeploy
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Entraînement pitch — job quotidien analyseur (Cloud Scheduler → POST /api/v1/internal/pitch-analyzer/run)
PITCH_ANALYZER_SECRET=
# Digest produit quotidien (GH Action ingest + Cloud Scheduler 18:00 Europe/Brussels → /internal/product-digest/run)
PRODUCT_DIGEST_SECRET=
AI_MODULE_FRICTION_SECRET=
# Optionnel Vertex Live (voix native) — v1 tourne en mode turn-based + SpeechSynthesis navigateur
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west9

# Médias (avatars / photos animaux) — vide en local = disk ./data/uploads
GCS_MEDIA_BUCKET=
# MEDIA_LOCAL_DIR=./data/uploads
# Staging GCP : GCS_MEDIA_BUCKET=petsfollow-media
