{
  "Name": "PetsFollowPACS",
  "HttpPort": 8080,
  "DicomServerEnabled": false,
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": false,
  "HttpsCACertificates": "/etc/ssl/certs/ca-certificates.crt",
  "HttpTimeout": 60,
  "StableAge": 30,
  "StrictAetComparison": false,
  "StorageCompression": false,
  "MaximumStorageSize": 0,
  "MaximumPatientCount": 0,
  "GoogleCloudStorage": {
    "BucketName": "petsfollow-dicom",
    "RootPath": "dicom/",
    "ServiceAccountFile": "/var/run/secrets/petsfollow-gcs-sa.json"
  },
  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": false,
    "Port": 5432,
    "EnableSsl": false,
    "Lock": false,
    "IndexConnectionsCount": 4,
    "MaximumConnectionRetries": 10,
    "ConnectionRetryInterval": 5
  },
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false,
    "QidoCaseSensitive": false,
    "Host": "",
    "StudiesMetadata": "Full",
    "SeriesMetadata": "Full"
  }
}
